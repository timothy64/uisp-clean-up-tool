# UISP Device Cleanup - Environment Variables
# Copy this file to .env and fill in your values.

# Your UISP server URL (no trailing slash)
UISP_HOST=https://uisp.example.com

# API token created in UISP > Settings > Users > API Tokens (needs Admin or Super Admin role for deletions)
UISP_TOKEN=your-api-token-here

# Local server port (default 3000)
PORT=3000

# Set to "true" to skip TLS certificate verification (for self-signed certs)
SKIP_TLS_VERIFY=false
